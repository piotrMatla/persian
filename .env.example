# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Port, na którym program będzie dostępny: http://serwer:8080/
EWNIOSKI_PORT=8080

# Baza MySQL / MariaDB (ta sama co dotychczas).
# MySQL na tym samym serwerze: host.docker.internal (MySQL musi nasłuchiwać nie tylko na 127.0.0.1
# i użytkownik musi mieć dostęp z sieci Dockera, np. 'user'@'172.%').
EWNIOSKI_DB_HOST=host.docker.internal
EWNIOSKI_DB_PORT=3306
EWNIOSKI_DB_USER=user
EWNIOSKI_DB_HASLO=dummy_pass
EWNIOSKI_DB_BAZA=ewnioski_test

# Adres programu używany w linkach w mailach
EWNIOSKI_ADRES=http://lora.pkc.motherson.com/eWnioski/php/

# Dane z confe.ini
EWNIOSKI_MAIL_PROGRAMISTA=
EWNIOSKI_MAIL_NOWY_WNIOSEK=
EWNIOSKI_UZUPELNIENIE_DANYCH=

# Wysyłka maili (bez SMTP_HOST maile nie są wysyłane)
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=eWnioski.Admin@motherson.com
SMTP_TLS=off
SMTP_USER=
SMTP_PASSWORD=

# 1 = zbuduj obraz z obsługą MS SQL (RCP, Saturn)
INSTALL_MSSQL=0
