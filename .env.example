# Konfiguracja eWnioski – skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
# W starej wersji te dane były zaszyte w kodzie (Common::MysqliConnect, Polaczenie.php) – tutaj idą przez środowisko.

APP_ENV=prod
APP_DEBUG=false
# Bazowy URL aplikacji (do linków w mailach). Bez ukośnika na końcu.
APP_URL=https://apps.example.local/eWnioski
APP_TIMEZONE=Europe/Warsaw

# Główna baza MySQL (wnioski, osoby, stan_godzin, dni_wolne, ...).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ewnioski
DB_USER=ewnioski_app
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Baza RCP (MSSQL) – moduł wejść/wyjść oraz logowanie kartą. Wymaga ext-pdo_sqlsrv.
# Pozostaw RCP_ENABLED=false, jeśli sterownik MSSQL nie jest dostępny (np. PHP 8.5 bez pdo_sqlsrv).
RCP_ENABLED=false
RCP_HOST=
RCP_DATABASE=RCP-PKC
RCP_USER=
RCP_PASSWORD=

# Powiadomienia e-mail.
MAIL_FROM=ewnioski.admin@example.local
MAIL_IT_ALERTS=it-alerts@example.local

# Katalogi na pliki (dawniej confe.ini: FolderLogs, FolderPlikow, FolderPlikowKierownicy).
STORAGE_LOGS=var/logs
STORAGE_UPLOADS=var/uploads
STORAGE_UPLOADS_MANAGERS=var/uploads-managers
